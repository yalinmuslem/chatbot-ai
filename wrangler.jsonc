{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafiq-chatbot",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
